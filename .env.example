# MongoDB Atlas connection string.
# Copy the exact URI from Atlas -> Connect -> Drivers and replace the placeholders.
# NEVER put your real password or any other secret in this file.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority"

# Backend API server port.
# The Vite frontend uses port 3000, so the Express API runs separately on 4000.
PORT=4000

# Application environment.
NODE_ENV=development

# Frontend URL used as the browser application's origin.
# Keep this separate from the backend API port.
WEB_URL="http://localhost:3000"

# Backend API URL used by the frontend when it calls the Express server.
API_URL="http://localhost:4000"
