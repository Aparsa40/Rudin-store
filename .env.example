# MongoDB Atlas URI; never commit the real .env file.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority"
PORT=4000
NODE_ENV=development
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4000"
# Browser-facing API base URL used by the Vite app.
VITE_API_URL="http://localhost:4000"
# Demo role buttons are disabled unless this is true in local development.
VITE_ENABLE_DEMO_AUTH="false"

# Required for API tokens. Generate a random secret of at least 32 characters.
# Example generator (PowerShell): [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
AUTH_TOKEN_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Only for one-time creation of the first administrator. Remove from .env after bootstrap.
ADMIN_BOOTSTRAP_SECRET="replace-with-a-separate-random-secret-at-least-32-characters"
